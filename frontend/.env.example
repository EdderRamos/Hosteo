# Desarrollo local: copiar a .env.local y reiniciar Vite.
# El navegador llama a /api/v1 y el proxy local conecta con el backend.
VITE_API_URL=/api/v1
DEV_API_PROXY_URL=http://localhost:8080

# Vercel: definir VITE_API_URL en Settings > Environment Variables.
# VITE_API_URL=https://hosteo-production.up.railway.app/api/v1
# DEV_API_PROXY_URL solo se usa en el servidor de desarrollo; no se expone al navegador.
